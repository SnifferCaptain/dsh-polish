# 构建结果与发布产物
# lib/ 是 npm pack 前由 build:client 生成的，不进入 Git。
/lib/
/build/
/dist/
/release/
/release-diag/
*.tsbuildinfo

# 测试代码、测试夹具与本地测试工具不进入发布仓库
/test/
/tools/visualize-test/
/coverage/
/.nyc_output/

# 依赖、缓存与本地 agent 状态
/node_modules/
/.npm-cache/
**/.agents/

# 本地脚本、临时输出与测试日志
_h*.txt
_bump*.cjs
_patch*.cjs
_fix-*.cjs
*.log
.tmp-*
tmp/
_artifacts/

# 编辑器和操作系统文件
.DS_Store
Thumbs.db
.vscode/
.idea/
