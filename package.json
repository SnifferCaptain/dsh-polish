{
  "name": "dsh-polish",
  "version": "1.5.0",
  "license": "MIT",
  "author": {
    "name": "SnifferCaptain",
    "url": "https://github.com/SnifferCaptain"
  },
  "homepage": "https://github.com/SnifferCaptain/dsh-polish#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SnifferCaptain/dsh-polish.git"
  },
  "bugs": {
    "url": "https://github.com/SnifferCaptain/dsh-polish/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "session-slim",
    "composer-history"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./thinking-renderer": {
      "default": "./thinking-renderer/index.js"
    },
    "./thinking-depth": {
      "default": "./thinking-depth/index.js"
    },
    "./composer-history": {
      "default": "./composer-history/index.js"
    },
    "./workspace-lru": {
      "default": "./workspace-lru/index.js"
    },
    "./timer": {
      "default": "./timer/index.js"
    },
    "./notify": {
      "default": "./notify/index.js"
    },
    "./mode-switch": {
      "default": "./mode-switch/index.js"
    },
    "./skill-loader": {
      "default": "./skill-loader/index.js"
    },
    "./prompts": {
      "default": "./prompts/index.js"
    },
    "./shell-local": {
      "default": "./shell-local/index.js"
    },
    "./visualize": {
      "default": "./visualize/index.js"
    },
    "./keep-effort": {
      "default": "./keep-effort/index.js"
    },
    "./session-slim": {
      "default": "./session-slim/index.js"
    },
    "./compact-model": {
      "default": "./compact-model/index.js"
    },
    "./ptc-log-repair": {
      "default": "./ptc-log-repair/index.js"
    },
    "./better-model-config": {
      "default": "./better-model-config/index.js"
    },
    "./workspace-guard": {
      "default": "./workspace-guard/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.mermaid.js",
    "thinking-renderer/",
    "thinking-depth/",
    "composer-history/",
    "workspace-lru/",
    "timer/",
    "notify/",
    "mode-switch/",
    "skill-loader/",
    "prompts/",
    "shell-local/",
    "visualize/",
    "keep-effort/",
    "session-slim/",
    "compact-model/",
    "ptc-log-repair/",
    "better-model-config/",
    "workspace-guard/",
    "skills/",
    "cordis.patch.yml",
    "README.md",
    "README_zh.md"
  ],
  "scripts": {
    "test": "node test/requirements.cjs && node test/bmc.test.cjs && node test/prompts-host.cjs && node test/compact-model-retry.cjs && node test/skill-loader.cjs && node test/harness.cjs",
    "build:i18n": "node scripts/build-i18n.cjs",
    "build:client": "node scripts/build-i18n.cjs && node scripts/build-host-entry.cjs && node scripts/build-client.cjs && node scripts/build-mermaid-chunk.cjs",
    "check:client": "node scripts/build-i18n.cjs --check && node scripts/build-host-entry.cjs --check && node scripts/build-client.cjs --check && node scripts/build-mermaid-chunk.cjs --check",
    "pack:release": "npm pack --pack-destination release"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-chat": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-chat": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm-pi-ai": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0",
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.1": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.5": "compatible"
      }
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "immediately": true
    }
  }
}
