  "timer": {
    "officialNote": "dsh-schedule supports one-shot / every N seconds / daily / weekly / cron, persists across restarts, and can deliver back into the original session. This timer (in-memory countdown, cleared on restart) is fully covered by it, so it is off by default; to restore the old behaviour, turn on both the row switch and the switch below.",
    "enabled.label": "Enable the timer (model tools)",
    "enabled.hint": "When on, the model can schedule reminders with timer_set / timer_cancel; the row switch is the master switch.",
